# API 呼叫的 base URL。開發時預設打到 Vite dev server 的 /api，
# 由 MSW（本機/測試）或後端反向代理實際接手。
VITE_API_BASE_URL=/api

# 是否啟用 MSW（Mock Service Worker）。只有在 DEV 模式且此值為 "true" 時才會啟動，
# 詳見 src/mocks/browser.ts。
VITE_ENABLE_MSW=true

# 登入模式："mock" 使用假登入（本機開發/測試預設），"keycloak" 串接真實 Keycloak。
VITE_AUTH_MODE=mock

# 以下三個變數只有在 VITE_AUTH_MODE=keycloak 時才需要填寫。
# 請勿把公司內部真實網址提交進版控，這裡只保留空白樣板。
VITE_KEYCLOAK_URL=
VITE_KEYCLOAK_REALM=
VITE_KEYCLOAK_CLIENT_ID=

# ag-Grid Enterprise License Key。留空時 grid 仍可啟動，
# 只會顯示官方 evaluation 浮水印，不會導致應用程式崩潰。
VITE_AG_GRID_LICENSE_KEY=
